CI_ENVIRONMENT = development
jobMatching.joobleApiKey = ''

app.baseURL = 'http://localhost:8080/'
app.appTimezone = Asia/Jakarta
app.forceGlobalSecureRequests = false
cookie.secure = false

# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the Supavisor Session pooler on port 5432.
database.default.hostname = 'aws-0-region.pooler.supabase.com'
database.default.database = postgres
database.default.username = 'postgres.project-ref'
database.default.password = 'replace-with-your-database-password'
database.default.DBDriver = Postgre
database.default.schema = public
database.default.port = 5432
database.default.sslmode = require

# Generate a unique key with: php spark key:generate
encryption.key =

# SMTP is required to send sign-in links for account recovery.
email.fromEmail = ''
email.fromName = 'CV Maker'
email.protocol = smtp
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = tls
